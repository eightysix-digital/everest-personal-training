{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m pip install -r requirements.txt -t .pydeps && PYTHONPATH=.pydeps python3 tools/build_blog.py && node tools/generate.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/coaching",
      "destination": "/personal-training/",
      "permanent": true
    },
    {
      "source": "/coaching/:path*",
      "destination": "/personal-training/",
      "permanent": true
    },
    {
      "source": "/performance",
      "destination": "/elite/",
      "permanent": true
    },
    {
      "source": "/performance/:path*",
      "destination": "/elite/",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/resources/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    },

    { "source": "/about-us", "destination": "/about/", "permanent": true },
    { "source": "/about-us/:path*", "destination": "/about/", "permanent": true },
    { "source": "/contact-us", "destination": "/contact/", "permanent": true },
    { "source": "/contact-us/:path*", "destination": "/contact/", "permanent": true },
    { "source": "/services", "destination": "/personal-training/", "permanent": true },
    { "source": "/services/:path*", "destination": "/personal-training/", "permanent": true },
    { "source": "/packages", "destination": "/programs/", "permanent": true },
    { "source": "/packages/:path*", "destination": "/programs/", "permanent": true },
    { "source": "/shop", "destination": "/programs/", "permanent": true },
    { "source": "/shop/:path*", "destination": "/programs/", "permanent": true },
    { "source": "/basket", "destination": "/programs/", "permanent": true },
    { "source": "/basket/:path*", "destination": "/programs/", "permanent": true },
    { "source": "/checkout", "destination": "/programs/", "permanent": true },
    { "source": "/checkout/:path*", "destination": "/programs/", "permanent": true },
    { "source": "/my-account", "destination": "/contact/", "permanent": true },
    { "source": "/my-account/:path*", "destination": "/contact/", "permanent": true },
    { "source": "/partners", "destination": "/organisations/", "permanent": true },
    { "source": "/partners/:path*", "destination": "/organisations/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
